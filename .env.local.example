# Local environment variables for SNN-WAM.
# Copy this file to .env.local and fill in your paths.
# .env.local is git-ignored and must never be committed.

# Python interpreter (optional, defaults to python3)
PYTHON=

# LIBERO repository checkout (required for G1.5 bootstrap)
LIBERO_REPO_ROOT=

# LIBERO dataset root (required for real-data experiments)
LIBERO_DATASET_ROOT=

# Alternative dataset root name (some LIBERO tools use this)
LIBERO_DATA_ROOT=
